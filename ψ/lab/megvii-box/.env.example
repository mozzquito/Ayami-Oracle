# Copy to .env and fill in real values. NEVER commit .env — .gitignore already covers it.
# (On Railway: set these as project Variables instead of a .env file — same names.)

# Port alarm-bridge.mjs listens on. On Railway this is set automatically via $PORT
# and this var is ignored; only needed for local runs. Must match what you pass to
# `configure-push --server-path <host>:<port>`.
ALARM_BRIDGE_PORT=8788

# Discord channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy
# Webhook URL. Plain HTTPS POST, no bot token/login needed.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# LINE Developers Console → your Messaging API channel → Messaging API tab →
# Channel access token (long-lived). Broadcasts to every friend of the OA.
LINE_CHANNEL_ACCESS_TOKEN=xxx

# Free account at https://cloudinary.com/users/register/free → Dashboard → shows
# a ready-to-copy "API Environment variable" in exactly this cloudinary://... form.
# Used to give LINE a public HTTPS URL for alarm photos (LINE fetches images itself,
# it can't receive raw bytes like Discord can). Leave unset to skip image upload —
# LINE still gets the text alert, just no photo attached.
CLOUDINARY_URL=cloudinary://xxx:xxx@xxx

# Comma-separated alarm minor-types to actually relay, e.g. "HOLDWEAPON" or
# "HOLDWEAPON,INTRUSION". Empty/unset = relay every event type (only useful for
# debugging what the box actually pushes — very noisy in real use).
# This is a SECOND filter on top of the device-side one (configure-push
# --minor-types) — keep both in sync, don't rely on just one.
ALARM_BRIDGE_ALLOWED_TYPES=HOLDWEAPON

# Minimum ms between relayed notifications of the SAME minor type. Protects
# against event bursts (e.g. a person lingering in an INTRUSION zone can
# trigger many times per second) spawning unbounded Discord/LINE sends.
ALARM_BRIDGE_COOLDOWN_MS=30000
