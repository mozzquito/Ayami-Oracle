# Copy this file to .env and fill in real values. .env is gitignored.
#
# IMPORTANT: use a freshly ROTATED Grafana password here — do not reuse any
# credential that has ever been pasted into a chat/terminal in plaintext.

GRAFANA_URL=http://10.0.163.250
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Prometheus datasource UID inside Grafana (Settings > Data sources > prometheus > uid in URL)
PROMETHEUS_DS_UID=be1w94z5h2io0b

# Discord webhook URL to deliver daily/weekly reports to. Leave unset to
# save reports locally only (generate/daily/weekly commands still work).
DISCORD_WEBHOOK_URL=

# Optional: override the Discord upload size cap (bytes). Defaults to 25MB,
# the standard non-boosted-server webhook limit.
# DISCORD_MAX_UPLOAD_BYTES=26214400
