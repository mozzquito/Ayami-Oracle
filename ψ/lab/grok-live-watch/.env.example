# Copy this file to .env in the same folder, then fill in real values there.
# .env is already covered by the repo's root .gitignore (.env pattern) — never commit it.
# NEVER paste these values into a chat session (Ayami/Claude/zcode/agy/Grok Bot) — type them
# only into this file directly, in your own editor/terminal.

# Binance TH — READ-ONLY key only. When creating it in the exchange console:
#   Enable Reading = ON
#   Enable Spot & Margin Trading = OFF
#   Enable Withdrawals = OFF
#   Restrict access to trusted IPs = ON (your monitoring host's IP)
BINANCE_TH_API_KEY=
BINANCE_TH_API_SECRET=
