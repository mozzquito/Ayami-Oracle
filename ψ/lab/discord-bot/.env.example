# Copy to .env and fill in real values. NEVER commit .env — .gitignore already covers it.

# From Discord Developer Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=xxx

# Your own Discord user ID (Settings → Advanced → Developer Mode, then right-click your name → Copy User ID).
# Only these IDs can command the bot. Comma-separate for more than one.
ALLOWED_USERS=123456789012345678

# Right-click the one text channel the bot should listen in → Copy Channel ID.
# The bot ignores every other channel, even in the same server.
TEXT_CHANNEL_ID=xxx

# Optional: a separate channel Ayami posts task/work summaries into, triggered by
# typing "สรุปงาน" in TEXT_CHANNEL_ID. Leave as xxx / unset to disable the feature.
REPORT_CHANNEL_ID=xxx

# Quick-brain model — handles ordinary chat fast and cheap via `agy`, read-only (--mode plan).
BRAIN_MODEL=gemini-3.6-flash-low

HISTORY_LINES=16

# Optional: mirrors บันทึกเทรด/เทรดจริง entries to the market-backtester dashboard's Redis
# (via server.py's /api/log-real-trade route), so the cloud dashboard can show something
# about your real trades next to the paper-trading signals. Leave unset to skip this —
# the local moss-real-trades.md log still works fine without it.
TRADE_LOG_WEBHOOK_URL=https://market-backtester-dashboard-production.up.railway.app/api/log-real-trade
TRADE_LOG_WEBHOOK_TOKEN=xxx

# Free API key from https://www.pexels.com/api/ (sign up, no approval wait) — used by the
# affiliate-draft feature (โปรโมท:/affiliate:/ขายของ: trigger) to find REAL stock photos/videos
# of people actually using similar products (2026-08-15, replaced the earlier anime-image
# approach). Required for that feature; the rest of the bot works fine without it.
PEXELS_API_KEY=xxx
